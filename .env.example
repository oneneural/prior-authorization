# Configuration reference. Copy to .env for Docker Compose only.
# Blank Compose values select defaults. Never put secrets or private host paths here.
# API/worker entries, test helpers and shell scripts read exported variables;
# they do not load the root .env. Do not bulk-source it: credentials are per process,
# and some optional CLI variables require absence rather than an empty value.
# Full reference: docs/operations.md#configuration-reference

# Compose deployment (compose.yaml).
# Web listener: 127.0.0.1:3105. Change port and trusted origin together.
APP_HOST_PORT=
PA_PUBLIC_ORIGIN=
# Application image tag (local), revision (unknown), creation label (unknown).
PA_IMAGE_TAG=
PA_BUILD_REVISION=
PA_BUILD_CREATED=
# Secret-file directory (./.secrets). init-secrets.sh also reads this from the shell.
# If changed only in .env, pass the same path with init-secrets.sh --dir.
PA_SECRETS_DIR=
# Compose project override; default prior-authorization in compose.yaml.
# backup.sh and restore.sh read the exported value, or use their --project flag.
COMPOSE_PROJECT_NAME=

# Supported runtime modes and tuning. APP_ID is fixed by Compose.
# DATA_MODE=fixture, AUTH_MODE=fixture, AGENT_MODE=rules; other modes are refused.
DATA_MODE=
AUTH_MODE=
AGENT_MODE=
# fatal, error, warn, info (default), debug, trace, silent.
LOG_LEVEL=
# Worker slots, 1 to 16 (default 2).
WORKER_CONCURRENCY=

# Agent investigation, API and worker only. No provider key is needed for off
# or recorded. off (default), recorded (scripted fixture) or live; live is only
# usable through compose.live.yaml, which requires its own values below.
AGENT_GRAPH_PROVIDER=
# Must be 0 (default) unless live. With live, each must be positive and at most
# USD 10 per run, USD 20 per UTC day and USD 20 lifetime.
AGENT_RUN_BUDGET_USD=
AGENT_DAILY_BUDGET_USD=
AGENT_TOTAL_BUDGET_USD=
# compose.live.yaml only, no defaults: a host directory outside the checkout
# holding the migrated accounting ledger, and the host path of the key file.
PA_ACCOUNTING_DIR=
PA_ANTHROPIC_API_KEY_HOST_FILE=
# Defaults and maximums: 10 tools, 6 provider turns, 180 seconds. May be lowered.
AGENT_MAX_TOOL_CALLS=
AGENT_MAX_MODEL_CALLS=
AGENT_MAX_RUN_SECONDS=

# Host-process configuration references, export only for the named process.
# APP_ID must be prior-authorization; NODE_ENV/TZ are set or inherited per process.
# APP_ID=
# API: database URL, worker service token and Better Auth session signing secret.
# DATABASE_URL_API_FILE=
# WORKER_SERVICE_TOKEN_FILE=
# BETTER_AUTH_SECRET_FILE=
# API, live mode only: absolute path of the canonical accounting ledger, and an
# optional evaluation admission token (32+ characters) that enables the
# separate evaluation caller's bounded admission routes.
# PA_ACCOUNTING_LEDGER_FILE=
# PA_EVALUATION_ADMISSION_TOKEN_FILE=
# Worker: worker database URL and the same service token, never the API secret.
# DATABASE_URL_WORKER_FILE=
# Worker, live mode only: absolute key file path, read when a live run starts.
# PA_ANTHROPIC_API_KEY_FILE=
# Init/provision: all four role URL files. Migrator: migrator URL file only.
# DATABASE_URL_ADMIN_FILE=
# DATABASE_URL_MIGRATOR_FILE=
# Inline counterparts exist for host compatibility only; prefer files. Never set
# NAME and NAME_FILE together. Never share one credential environment across roles.
# DATABASE_URL_ADMIN, DATABASE_URL_MIGRATOR, DATABASE_URL_API, DATABASE_URL_WORKER,
# WORKER_SERVICE_TOKEN, BETTER_AUTH_SECRET
# POSTGRES_PASSWORD / POSTGRES_PASSWORD_FILE belong to db, forbidden in app.
# Compose fixes POSTGRES_USER, POSTGRES_DB and POSTGRES_INITDB_ARGS for db.

# External tracing guard, host API/worker/live evaluator: unset or false only.
# Compose's launcher never forwards these variables.
# LANGSMITH_TRACING=
# LANGSMITH_TRACING_V2=
# LANGCHAIN_TRACING=
# LANGCHAIN_TRACING_V2=

# Disposable PostgreSQL (compose.test.yaml). Export the same generated password
# for pnpm tests; a value in .env alone reaches Compose but not the test process.
PA_TEST_POSTGRES_PASSWORD=
# Optional exported full admin URL for a different disposable server. Sensitive:
# keep it out of .env and logs. Overrides the password-based test URL.
# PA_TEST_ADMIN_DATABASE_URL=
# Container-test override inputs, supplied by scripts/container/harness.ts.
# PA_CTEST_JOB_DELAY_MS=       # default 0, maximum 120000
# PA_CTEST_WORKER_CONCURRENCY= # default 2
# PILOT_TEST_JOB_DELAY_MS=     # host worker delay, default 0; fixture mode only

# Offline HTTP walkthrough. Export for direct walkthrough.mjs use; the smoke
# wrapper supplies its own loopback origin from --port. Default if unset:
# http://127.0.0.1:3105 (empty is not a valid origin).
# PA_DEMO_ORIGIN=

# Separate paid evaluation CLI only. These DO NOT enable packaged live mode.
# It holds no ledger: every attempt is admitted by a running live-mode API.
# Confirm recorded budget authority first. No defaults for the absolute key and
# token paths, the loopback API origin or the positive run cap (at most USD 10,
# within the API's day and lifetime caps). PA_ANTHROPIC_LEDGER_FILE is retired
# and refused.
# PA_ANTHROPIC_API_KEY_FILE=
# PA_ADMISSION_API_ORIGIN=              # for example http://127.0.0.1:4105
# PA_EVALUATION_ADMISSION_TOKEN_FILE=
# PA_LIVE_RUN_CAP_USD=
# PA_LIVE_EFFORT=      # low, medium (default), high
# PA_LIVE_CASES=       # optional comma-separated case IDs, unset selects all
# PA_LIVE_RUN_LABEL=   # optional a-z/0-9/hyphen, 1-40 chars; unset defaults to full
# PA_LIVE_PROMPT_NOTE= # optional factual report note, no secrets or model text

# Packaging-owned settings are not .env knobs: NODE_ENV, NEXT_TELEMETRY_DISABLED,
# CI, PATH, EVIDENCE_ROOT, S6_READ_ONLY_ROOT, S6_BEHAVIOUR_IF_STAGE2_FAILS,
# S6_CMD_WAIT_FOR_SERVICES_MAXTIME, S6_KILL_GRACETIME, S6_VERBOSITY, HOSTNAME, PORT.
# TZ is allowlisted by the launcher but not wired through Compose.
# Docker build args NODE_IMAGE, POSTGRES_IMAGE, TARGETARCH and BUILDPLATFORM are
# not runtime settings. Use the reviewed Dockerfile pins and platform selection.
# Docker tooling inherits DOCKER_HOST/DOCKER_CONTEXT and HOME/PATH; smoke uses TMPDIR.
# ANTHROPIC_API_KEY and LANGSMITH_API_KEY are cleared by the smoke wrapper;
# they do not configure the provider, which uses an explicit key file and endpoint.
# Do not add proposed ADR settings before their implementation.
