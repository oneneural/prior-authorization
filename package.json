{
  "name": "prior-authorization",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json && pnpm -r typecheck",
    "test": "vitest run --project unit",
    "test:evals": "vitest run --project evals --reporter=default",
    "test:evals:live": "vitest run --project evals-live --reporter=default",
    "test:contribution": "vitest run --project unit --project evals evals/src/contribution --reporter=default",
    "test:oracles:v2": "vitest run --project oracles-v2 --reporter=default",
    "test:integration": "vitest run --project integration",
    "test:web": "vitest run --project web",
    "test:container": "vitest run --project container",
    "accounting": "node apps/api/dist/accounting/cli.js",
    "db:test:up": "docker compose -f compose.test.yaml up -d --wait",
    "db:test:down": "PA_TEST_POSTGRES_PASSWORD=unused-for-down docker compose -f compose.test.yaml down -v"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@next/eslint-plugin-next": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
